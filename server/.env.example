# 이 파일을 복사해서 server/.env 로 만들고 값을 채워주세요. (.env 는 git 에 올라가지 않아요)

# MongoDB Atlas 접속 문자열 (먼저 시도). 끝에 DB 이름(/lottery)을 붙여주세요.
MONGODB_ATLAS_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lottery
# 로컬 MongoDB (Atlas 연결이 안 될 때 대신 사용)
MONGODB_URI=mongodb://127.0.0.1:27017/lottery

# 로그인 토큰 서명용 비밀 문자열. 아래 명령으로 만들 수 있어요.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# 이 이메일로 가입/로그인한 계정은 자동으로 admin(user_type) 이 돼요.
ADMIN_EMAIL=you@example.com

PORT=3000
